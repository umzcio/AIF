# AIF Portal — Environment Variables
# Copy to .env and fill in values

# === API Keys (required for agent pipeline) ===
OPENAI_API_KEY=sk-...                  # Codex CLI (pass 1)
OPENROUTER_API_KEY=sk-or-...           # MiniMax + MiMo + Kimi + GLM (passes 2-5)
ANTHROPIC_API_KEY=sk-ant-...           # Claude Code CLI (synthesis)
SNYK_TOKEN=                            # Optional — Snyk agent-scan

# === Database ===
DATABASE_URL=postgresql://aif:changeme@db:5432/aif
DB_PASSWORD=changeme                   # Change in production

# === Authentication ===
# AUTH_PROVIDER selects the SSO strategy. Options:
#   cas     — CAS SSO (set CAS_BASE_URL + CAS_SERVICE_URL)
#   oidc    — OpenID Connect / Entra ID (planned — set OIDC_* vars)
#   saml    — SAML 2.0 (planned — set SAML_* vars)
#   header  — Reverse proxy auth / Shibboleth (set AUTH_HEADER_USER)
#   bypass  — Dev mode, auto-creates admin user (do not use in production)
AUTH_PROVIDER=bypass
JWT_SECRET=                            # Required — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_NETIDS=                          # Comma-separated usernames for auto-admin role

# --- CAS (AUTH_PROVIDER=cas) ---
CAS_BASE_URL=https://login.example.edu/cas
CAS_SERVICE_URL=https://your-domain.edu/aif/api/auth/callback

# --- OIDC (AUTH_PROVIDER=oidc) — planned ---
# OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-domain.edu/aif/api/auth/callback

# --- SAML (AUTH_PROVIDER=saml) — planned ---
# SAML_ENTRY_POINT=https://idp.example.edu/idp/profile/SAML2/Redirect/SSO
# SAML_ISSUER=aif-portal
# SAML_CERT=
# SAML_CALLBACK_URL=https://your-domain.edu/aif/api/auth/callback

# --- Header (AUTH_PROVIDER=header) ---
# AUTH_HEADER_USER=REMOTE_USER
# AUTH_HEADER_DISPLAY_NAME=displayName

# === URLs ===
FRONTEND_URL=https://your-domain.edu/aif/

# === Institution Identity ===
INSTITUTION_NAME=Your Institution
INSTITUTION_DOMAIN=example.edu

# === Email Notifications (optional) ===
SMTP_HOST=                             # SMTP relay hostname (e.g. smtp.example.edu)
SMTP_PORT=25
SMTP_FROM=                             # From address (e.g. noreply-aif@example.edu)
