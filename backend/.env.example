# AIF Portal — Environment Variables
# Copy to .env and fill in values

# === API Keys (required for agent pipeline) ===
OPENAI_API_KEY=sk-...
GOOGLE_GENERATIVE_AI_API_KEY=...
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...
SNYK_TOKEN=                            # Optional — Snyk agent-scan

# === Database ===
DATABASE_URL=postgresql://aif:changeme@db:5432/aif
DB_PASSWORD=changeme

# === Authentication ===
JWT_SECRET=                            # Required — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_BYPASS=false                      # Set true for local dev without CAS
ADMIN_NETIDS=                          # Comma-separated CAS netids for auto-admin role

# === URLs ===
CAS_SERVICE_URL=https://your-domain.edu/aif/api/auth/callback
FRONTEND_URL=https://your-domain.edu/aif/

# === Institution Identity ===
INSTITUTION_NAME=University of Montana
INSTITUTION_DOMAIN=umontana.edu

# === Email Notifications ===
SMTP_HOST=smtp.umt.edu                  # Internal SMTP relay (no auth)
SMTP_PORT=25
SMTP_FROM=noreply-aif@umontana.edu
